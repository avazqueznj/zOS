       LOCAL-STORAGE SECTION.


      ****************************************************************
       PROCEDURE DIVISION.

       000-MAIN.

           DISPLAY 'SALESRPT 8 STARTING... V1'.

      *    OPEN FILES
           PERFORM 100-OPEN-FUNDS-FILE.
           PERFORM 110-OPEN-PRICES-FILE.
           PERFORM 120-OPEN-SALES-FILE.
           PERFORM 130-OPEN-REPORT-FILE.
           PERFORM 140-OPEN-TEMP-FILE-WRITE.

      *    PREPARE HEADER
           PERFORM 420-PREPARE-HEADER.

      *    BUILD FUND/FUND PRICE TABLE
           PERFORM 300-PROCESS-FUND-PRICE-TABLE.
           PERFORM 320-PROCESS-SALES-TABLE.
           PERFORM 430-PRINT-REPORT-TOTALS.

      *    HIGH SALES REPORT
           PERFORM 620-CLOSE-TEMP-FILE
           PERFORM 150-OPEN-TEMP-FILE-READ.
           PERFORM 340-PROCESS-HIGH-SALES.
           PERFORM 350-PROCESS-HIGH-SALES-SUMMARY.

      *    CLOSE FILES
           PERFORM 600-CLOSE-SALE-FILE.
           PERFORM 610-CLOSE-REPORT-FILE.
           PERFORM 620-CLOSE-TEMP-FILE.

           STOP RUN.


       100-OPEN-FUNDS-FILE.

           DISPLAY 'OPENING FUNDS FILE...'.

           OPEN INPUT FUND-FILE.
           IF NOT FUND-FILE-OK
              DISPLAY 'FATAL: FUND-FILE OPEN ERROR '
                   WS-FUND-FILE-STATUS
              STOP RUN
           END-IF.


       110-OPEN-PRICES-FILE.

           DISPLAY 'OPENING PRICES FILE...'.

           OPEN INPUT PRICE-FILE .
           IF NOT PRICE-FILE-OK
              DISPLAY 'FATAL: PRICE-FILE OPEN ERROR '
                   WS-PRICE-FILE-STATUS
              STOP RUN
           END-IF.


       120-OPEN-SALES-FILE.

           DISPLAY 'OPENING SALES FILE...'.

           OPEN INPUT SALES-FILE .
           IF NOT SALES-FILE-OK
              DISPLAY 'FATAL: SALE-FILE OPEN ERROR '
                   WS-SALES-FILE-STATUS
              STOP RUN
           END-IF.


       130-OPEN-REPORT-FILE.

           DISPLAY 'OPENING REPORT FILE...'.

           OPEN OUTPUT REPORT-FILE.
           IF NOT REPORT-FILE-OK
              DISPLAY 'FATAL: REPORT-FILE OPEN ERROR '
                   WS-REPORT-FILE-STATUS
              STOP RUN
           END-IF.


       140-OPEN-TEMP-FILE-WRITE.

           DISPLAY 'OPENING TEMP FILE... WRITE'.

           OPEN OUTPUT TEMP-SALES-FILE.

           IF NOT TEMP-FILE-OK
              DISPLAY 'FATAL: TEMP FILE OPEN ERROR: '
                   WS-TEMP-FILE-STATUS
              STOP RUN
           END-IF.


       150-OPEN-TEMP-FILE-READ.

           DISPLAY 'OPENING TEMP FILE... READ'.

           OPEN INPUT TEMP-SALES-FILE.

           IF NOT TEMP-FILE-OK
              DISPLAY 'FATAL: TEMP FILE OPEN ERROR: '
                   WS-TEMP-FILE-STATUS
              STOP RUN
           END-IF.



       300-PROCESS-FUND-PRICE-TABLE.

           DISPLAY "BUILDING FUND-PRICE TABLE ".

           MOVE 0 TO WS-FUND-COUNT.

           MOVE 'N' TO WS-END-OF-FILE.
           PERFORM UNTIL END-OF-FILE
              READ FUND-FILE
                  AT END
                      SET END-OF-FILE TO TRUE
                  NOT AT END

                  PERFORM 310-READ-FUND-PRICE-ROW

              END-READ
           END-PERFORM.


       310-READ-FUND-PRICE-ROW.

           DISPLAY IN-FUND-NBR '-' IN-FUND-NME '-' IN-FUND-COMM-PCT.

      *    SAVE THE FUND TO THE TABLE
           ADD 1 TO WS-FUND-COUNT.
           SET TBL-FUND-NDX TO WS-FUND-COUNT.

           MOVE IN-FUND-NBR TO
               TBL-FUND-NBR(TBL-FUND-NDX).
           MOVE IN-FUND-NME TO
               TBL-FUND-NME(TBL-FUND-NDX).
           MOVE IN-FUND-COMM-PCT TO
               TBL-FUND-COMM-PCT(TBL-FUND-NDX).

      *    SAVE THE FUND'S PRICES TO THE TABLE (PRE ORDERED)
           READ PRICE-FILE
             AT END
                 DISPLAY
                     'FATAL: PRICE FILE ENDED BEFORE FUND FILE'
                 STOP RUN

             NOT AT END

      *      SAVE 3 PRICES
             MOVE IN-FUND-SHR-PRC(1)
               TO TBL-FUND-SHR-PRC(TBL-FUND-NDX, 1)
             MOVE IN-FUND-SHR-PRC(2)
               TO TBL-FUND-SHR-PRC(TBL-FUND-NDX, 2)
             MOVE IN-FUND-SHR-PRC(3)
               TO TBL-FUND-SHR-PRC(TBL-FUND-NDX, 3)

           END-READ.

      *      CHECK
             DISPLAY WS-FUND-COUNT
             ' ' TBL-FUND-NBR(TBL-FUND-NDX)
             '-' TBL-FUND-NME(TBL-FUND-NDX)
             '-' TBL-FUND-COMM-PCT(TBL-FUND-NDX)
             '-' TBL-FUND-SHR-PRC(TBL-FUND-NDX, 1)
             '-' TBL-FUND-SHR-PRC(TBL-FUND-NDX, 2)
             '-' TBL-FUND-SHR-PRC(TBL-FUND-NDX, 3).


       320-PROCESS-SALES-TABLE.

           DISPLAY "PROCESSING SALES".

           MOVE 'N' TO WS-END-OF-FILE.
           PERFORM UNTIL END-OF-FILE
              READ SALES-FILE
                  AT END
                      SET END-OF-FILE TO TRUE
                  NOT AT END

                  PERFORM 330-PROCESS-SALES-RECORD

              END-READ
           END-PERFORM.


       330-PROCESS-SALES-RECORD.

           PERFORM VARYING I FROM 1 BY 1
              UNTIL I > 4 OR SALE-FUND-NBR(I) = ZERO

      *       COUNT
              ADD 1 TO WS-SALES-COUNT
              ADD SALE-DEP-AMT(I) TO WS-TOTAL-DEPOSITS

      *       PRINT HEADERS IF NECESSARY
              IF WS-LINE-COUNT = 0 THEN
                 PERFORM 410-PRINT-REPORT-HEADINGS
                 PERFORM 400-PRINT-COLUMN-HEADINGS
              END-IF

      *       BRANCH AND BORKER ON FIRST SALE
              IF I = 1 THEN
                 MOVE SALE-BRANCH-NME TO WS-DTL-BRANCH-NME
                 MOVE SALE-BROKER-NME TO WS-DTL-BROKER-NME
                 DISPLAY SALE-BRANCH-NME '-' SALE-BROKER-NME
                 ADD 1 TO WS-BROKER-COUNT
              ELSE
                 MOVE SPACES TO WS-DTL-BRANCH-NME
                 MOVE SPACES TO WS-DTL-BROKER-NME
              END-IF

      *       RESET
              MOVE ZERO TO WS-DTL-SHARE-AMT
              MOVE ZERO TO WS-DTL-COMMISSION-AMT

      *       FIND THE FUND OF THIS SALE
              SEARCH ALL TBL-FUND-ENTRY

      *          NOT FOUND <<>>
                 AT END

                    MOVE SALE-FUND-NBR(I) TO WS-DTL-FUND-NBR
                    MOVE '**** FUND NOT FOUND *****' TO WS-DTL-FUND-NME
                    MOVE SALE-DEP-AMT(I) TO WS-DTL-DEP-AMT
                    MOVE ZERO TO WS-DTL-SHARE-AMT
                    MOVE ZERO TO WS-DTL-COMMISSION-AMT

                    DISPLAY
                      '    *' I ' *** FUND NOT FOUND *** ->'
                      SALE-FUND-NBR(I)

      *          FUND FOUND  >><<
                 WHEN TBL-FUND-NBR(TBL-FUND-NDX) = SALE-FUND-NBR(I)

      *             DEBUG REMOVE LATER ...
                    DISPLAY
                        '*** DEBUG *** -> '
                        SALE-BRANCH-NME ' '
                        SALE-BROKER-NME ' : '
                        I '  ' SALE-FUND-NBR(I)
                        '=' TBL-FUND-NBR(TBL-FUND-NDX)
                        ' ' TBL-FUND-NME(TBL-FUND-NDX)
                        ' ' SALE-SHR-PRC-FLG(I)
                        ' ' SALE-DEP-AMT(I)

                    MOVE TBL-FUND-NBR(TBL-FUND-NDX) TO WS-DTL-FUND-NBR
                    MOVE TBL-FUND-NME(TBL-FUND-NDX) TO WS-DTL-FUND-NME
                    MOVE SALE-DEP-AMT(I) TO WS-DTL-DEP-AMT

      *    PRICE CALCULATION

      *             CANNOT DO TBL-FUND-NDX, SALE-SHR-PRC-FLG(I)
                    COMPUTE WS-SHR-PRC-ID = SALE-SHR-PRC-FLG(I)

      *             GUARDS KEY, PRICE, DEPOSIT CHECK
                    IF SALE-SHR-PRC-FLG(I) >= 1
                       AND SALE-SHR-PRC-FLG(I) <= 3
                       AND TBL-FUND-SHR-PRC(
                          TBL-FUND-NDX, WS-SHR-PRC-ID) > 0
                       AND SALE-DEP-AMT(I) > 0
                       THEN

      *                SELECTED IS -> SALE-SHR-PRC-FLG(I)
      *                SO PRICE IS TBL-FUND-SHR-PRC(SALE-SHR-PRC-FLG(I))

      *                SO AMOUT SOLD IS
                       COMPUTE WS-SHARE-AMT ROUNDED  =
                          SALE-DEP-AMT(I) /
                             TBL-FUND-SHR-PRC(
                                TBL-FUND-NDX, WS-SHR-PRC-ID)

                       MOVE WS-SHARE-AMT TO WS-DTL-SHARE-AMT

      *                CALCULATE HIGH SALES
                       IF WS-SHARE-AMT > 10000.000

                          MOVE SALE-BROKER-NME TO HS-BROKER-NME
                          MOVE SALE-FUND-NBR(I) TO HS-FUND-NBR
                          MOVE WS-SHARE-AMT TO HS-SHR-AMT

                          WRITE HIGH-SALES-RECORD

                          IF NOT TEMP-FILE-OK
                             DISPLAY 'FATAL: TEMP FILE WRITE ERROR: '
                                WS-TEMP-FILE-STATUS
                             STOP RUN
                          END-IF

                       END-IF

      *                COMISSION CALCULATION
                       COMPUTE WS-COMMISSION-AMT ROUNDED =
                          ( SALE-DEP-AMT(I)
                             * TBL-FUND-COMM-PCT(TBL-FUND-NDX) )
                                / 100

                       MOVE WS-COMMISSION-AMT TO WS-DTL-COMMISSION-AMT
                       ADD WS-COMMISSION-AMT TO WS-TOTAL-COMMISSIONS

                    ELSE
      *                SOMETHING WAS NOT VALID, BAILED OUT
                       MOVE ZERO TO WS-DTL-SHARE-AMT
                       MOVE ZERO TO WS-DTL-COMMISSION-AMT

                       DISPLAY
                          '*** DATA ERROR *** -> '
                          SALE-BRANCH-NME ' '
                          SALE-BROKER-NME ' : '
                          I '  ' SALE-FUND-NBR(I)
                          '=' TBL-FUND-NBR(TBL-FUND-NDX)
                          ' ' TBL-FUND-NME(TBL-FUND-NDX)
                          ' ' SALE-SHR-PRC-FLG(I)
                          ' ' SALE-DEP-AMT(I)

                    END-IF

               END-SEARCH

               WRITE REPORT-RECORD FROM WS-DETAIL-LINE
               WRITE REPORT-RECORD FROM WS-BLANK-ROW

      *        PAGINATION
               COMPUTE WS-LINE-COUNT =  WS-LINE-COUNT + 2
               IF WS-LINE-COUNT >= 43 THEN
                 MOVE ZERO TO WS-LINE-COUNT
               END-IF

           END-PERFORM.
      *    END LOOP


       340-PROCESS-HIGH-SALES.

           DISPLAY 'PROCESS HS SALES...'.

      **   PRINT HEADER **
           MOVE ZERO TO WS-PAGE-COUNT.
           MOVE ZERO TO WS-LINE-COUNT.
           PERFORM 500-WRITE-HIGH-SALES-HEADER.
           PERFORM 510-WRITE-HIGH-SALES-COL-HEADR.

      **   RESET EOF FLAG   **
           SET NOT-END-OF-FILE TO TRUE.

      **   PROCESS  **
           PERFORM UNTIL END-OF-FILE
              READ TEMP-SALES-FILE

                 AT END
                     SET END-OF-FILE TO TRUE
                 NOT AT END

      **         PAGINATION  **
                 IF WS-LINE-COUNT >= 36
                     MOVE ZERO TO WS-LINE-COUNT
                     PERFORM 500-WRITE-HIGH-SALES-HEADER
                     PERFORM 510-WRITE-HIGH-SALES-COL-HEADR
                 END-IF

      *          WE DONT HAVE THE FUND NAME
                 SEARCH ALL TBL-FUND-ENTRY
                    AT END
                       MOVE '**** FUND NOT FOUND *****'
                          TO WS-HS-FUND-NME

                    WHEN TBL-FUND-NBR(TBL-FUND-NDX) = HS-FUND-NBR
                       MOVE TBL-FUND-NME(TBL-FUND-NDX)
                          TO WS-HS-FUND-NME

                 END-SEARCH

                 ADD 1 TO WS-HIGH-SALE-COUNT

      *          BLANK IF SAME BROKER
                 IF HS-BROKER-NME = WS-PREV-HS-BROKER
                    MOVE SPACES TO WS-HS-BROKER-NME
                 ELSE
                    MOVE HS-BROKER-NME TO WS-HS-BROKER-NME
                    ADD 1 TO WS-HIGH-BROKER-COUNT
                 END-IF

                 MOVE HS-BROKER-NME TO WS-PREV-HS-BROKER
                 MOVE HS-FUND-NBR TO WS-HS-FUND-NBR
                 MOVE HS-SHR-AMT TO WS-HS-SHR-AMT

                 WRITE REPORT-RECORD FROM WS-HIGH-SALES-DETAIL
                 WRITE REPORT-RECORD FROM WS-BLANK-ROW
                 ADD 2 TO WS-LINE-COUNT

      **         RUNNING TOTALS   **


              END-READ
           END-PERFORM.

      *     PRINT FINAL SUMMARY

       350-PROCESS-HIGH-SALES-SUMMARY.

           DISPLAY 'WRITE HS SALES SUMMARY...'.

           PERFORM 500-WRITE-HIGH-SALES-HEADER.

           MOVE WS-HIGH-SALE-COUNT TO WS-PRINT-HIGH-SALE-COUNT
           MOVE WS-HIGH-BROKER-COUNT TO WS-PRINT-HIGH-BROKER-COUNT

           WRITE REPORT-RECORD FROM WS-BLANK-ROW.
           WRITE REPORT-RECORD FROM WS-HIGH-SALES-TOTALS-COLUMNS.
           WRITE REPORT-RECORD FROM WS-HIGH-SALES-TOT-UNDERLINES.
           WRITE REPORT-RECORD FROM WS-BLANK-ROW.
           WRITE REPORT-RECORD FROM WS-HIGH-SALES-TOTALS-DETAIL.



       400-PRINT-COLUMN-HEADINGS.

           WRITE REPORT-RECORD FROM WS-COLUMN-HEADER-1
           WRITE REPORT-RECORD FROM WS-COLUMN-HEADER-2
           WRITE REPORT-RECORD FROM WS-COLUMN-HYPHENS
           WRITE REPORT-RECORD FROM WS-BLANK-ROW.

           COMPUTE WS-LINE-COUNT =  WS-LINE-COUNT + 4.


       410-PRINT-REPORT-HEADINGS.

           ADD 1 TO WS-PAGE-COUNT
           MOVE WS-PAGE-COUNT TO WS-HEADER-PAGE-NUM

           WRITE REPORT-RECORD FROM WS-PAGE-HEADER-1
           WRITE REPORT-RECORD FROM WS-PAGE-HEADER-2
           WRITE REPORT-RECORD FROM WS-BLANK-ROW

           ADD 3 TO WS-LINE-COUNT

           IF NOT REPORT-FILE-OK
              DISPLAY 'FATAL: REPORT FILE WRITE ERROR: '
                 WS-REPORT-FILE-STATUS
              STOP RUN
           END-IF.


       420-PREPARE-HEADER.

           DISPLAY 'PREPARE HEADER ...'.

      *    RESET
           MOVE ZERO TO WS-PAGE-COUNT.
           MOVE ZERO TO WS-LINE-COUNT.

      *    GET TODAY'S DATE
           MOVE FUNCTION CURRENT-DATE TO WS-CURRENT-DATE.
           MOVE CORRESPONDING WS-CURRENT-DATE TO WS-HEADER-DATE.

      *    GET JOB NAME  !! LINKER ERROR !! TBD DISCUSS W TEACHER
      *    --> AMODE24 application without using runtime options

      *    CALL WS-JOBNAME-LIB USING WS-JOBNAME
           MOVE WS-JOBNAME TO WS-HEADER-JOB-NAME



      *    CHANGE HOUR TO AM/PM
           MOVE CURRENT-TIME(1:2) TO WS-HEADER-HOUR
           IF WS-HEADER-HOUR = 0
               MOVE 12 TO WS-HEADER-HOUR
               MOVE 'AM' TO WS-HEADER-AM-PM
           ELSE
               IF WS-HEADER-HOUR < 12
                   MOVE 'AM' TO WS-HEADER-AM-PM
               ELSE
                   MOVE 'PM' TO WS-HEADER-AM-PM
                   IF WS-HEADER-HOUR > 12
                       SUBTRACT 12 FROM WS-HEADER-HOUR
                   END-IF
               END-IF
           END-IF

           MOVE CURRENT-TIME(3:2) TO WS-HEADER-MINUTE.


       430-PRINT-REPORT-TOTALS.

           PERFORM 410-PRINT-REPORT-HEADINGS.

           COMPUTE WS-AVG-DEPOSIT-BROKER ROUNDED =
              WS-TOTAL-DEPOSITS / WS-BROKER-COUNT

           COMPUTE WS-AVG-DEPOSIT-SALE ROUNDED =
              WS-TOTAL-DEPOSITS / WS-SALES-COUNT

           MOVE WS-BROKER-COUNT       TO WS-TOT-BROKER-COUNT.
           MOVE WS-SALES-COUNT        TO WS-TOT-SALES-COUNT.
           MOVE WS-TOTAL-DEPOSITS     TO WS-TOT-DEPOSITS.
           MOVE WS-TOTAL-COMMISSIONS  TO WS-TOT-COMMISSIONS.
           MOVE WS-AVG-DEPOSIT-BROKER TO WS-TOT-AVG-BROKER.
           MOVE WS-AVG-DEPOSIT-SALE   TO WS-TOT-AVG-SALE.

           WRITE REPORT-RECORD FROM WS-TOTALS-COLUMN-HEADER.
           WRITE REPORT-RECORD FROM WS-TOTALS-HYPHENS.
           WRITE REPORT-RECORD FROM WS-TOTALS-DETAIL.

           WRITE REPORT-RECORD FROM WS-BLANK-ROW.
           WRITE REPORT-RECORD FROM WS-AVG-BROKER-LINE.
           WRITE REPORT-RECORD FROM WS-BLANK-ROW.
           WRITE REPORT-RECORD FROM WS-AVG-SALE-LINE.


       500-WRITE-HIGH-SALES-HEADER.

           MOVE 3 TO WS-LINE-COUNT.
           COMPUTE  WS-PAGE-COUNT = WS-PAGE-COUNT + 1.
           MOVE WS-PAGE-COUNT TO WS-HEADER-PAGE-NUM.

           WRITE REPORT-RECORD FROM WS-PAGE-HEADER-1.
           WRITE REPORT-RECORD FROM WS-HIGH-SALES-PAGE-HEADER-2.
           WRITE REPORT-RECORD FROM WS-BLANK-ROW.

           IF NOT REPORT-FILE-OK
               DISPLAY 'FATAL: REPORT FILE WRITE ERROR: '
                   WS-REPORT-FILE-STATUS
               STOP RUN
           END-IF.


       510-WRITE-HIGH-SALES-COL-HEADR.

           WRITE REPORT-RECORD FROM WS-HIGH-SALES-COLUMN-HEADERS.
           WRITE REPORT-RECORD FROM WS-HIGH-SALES-UNDERLINES.
           WRITE REPORT-RECORD FROM WS-BLANK-ROW.
           ADD 3 TO WS-LINE-COUNT

           IF NOT REPORT-FILE-OK
               DISPLAY 'FATAL: REPORT FILE WRITE ERROR: '
                   WS-REPORT-FILE-STATUS
               STOP RUN
           END-IF.


       600-CLOSE-SALE-FILE.

           DISPLAY 'CLOSING SALES FILE...'.

           CLOSE SALES-FILE.

           IF NOT SALES-FILE-OK
               DISPLAY 'FATAL: SALE FILE CLOSE ERROR: '
                   WS-SALES-FILE-STATUS
              STOP RUN
           END-IF.


       610-CLOSE-REPORT-FILE.

           DISPLAY 'CLOSING REPORT FILE...'.

           CLOSE REPORT-FILE.

           IF NOT REPORT-FILE-OK
               DISPLAY 'FATAL: REPORT FILE CLOSE ERROR '
                   WS-REPORT-FILE-STATUS
              STOP RUN
           END-IF.

       620-CLOSE-TEMP-FILE.

           DISPLAY 'CLOSING TEMP FILE...'.

           CLOSE TEMP-SALES-FILE.

           IF NOT TEMP-FILE-OK
               DISPLAY 'FATAL: TEMP FILE CLOSE ERROR '
                   WS-TEMP-FILE-STATUS
              STOP RUN
           END-IF.

       END PROGRAM SALESRPT.


